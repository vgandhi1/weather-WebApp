# Copy to `.env` and replace placeholder values. Never commit `.env`.
# Vite only exposes variables prefixed with `VITE_` to the client bundle.

# --- Required (weather) ---
# OpenWeatherMap: https://openweathermap.org/api
# Used at build time for production; embedded in the shipped JS.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Optional: news & local guide (RSS) ---
# Google News RSS is proxied through rss2json for CORS-friendly static hosting.
# Anonymous tier is enough for light use; add a key if you hit rate limits.
# https://rss2json.com/docs
# VITE_RSS2JSON_API_KEY=

# --- Optional: NewsAPI (development + proxied production only) ---
# Dev: direct browser calls to newsapi.org when this key is set.
# Production: calls same-origin `/api/news?...` only if BOTH the key and proxy flag are set.
# Plain GitHub Pages has no `/api/news` — leave proxy unset so the app uses RSS instead.
# VITE_NEWS_API_KEY=
# VITE_NEWS_PROXY=true
